{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "invo-learn lesson report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "lesson_id", "track_id", "completed_on", "objectives", "misconceptions", "recommended_next_steps", "prerequisite_gaps"],
  "properties": {
    "schema_version": {"const": 1},
    "report_id": {"$ref": "#/$defs/id"},
    "lesson_id": {"$ref": "#/$defs/id"},
    "track_id": {"$ref": "#/$defs/id"},
    "completed_on": {"type": "string", "format": "date"},
    "assignment_context": {"type": "object"},
    "session_status": {"enum": ["completed", "in-progress"]},
    "objectives": {"type": "array", "items": {"$ref": "#/$defs/objective"}},
    "misconceptions": {"$ref": "#/$defs/strings"},
    "recommended_next_steps": {"$ref": "#/$defs/strings"},
    "prerequisite_gaps": {"$ref": "#/$defs/strings"},
    "suspected_errors": {"type": "array", "items": {"$ref": "#/$defs/error"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "description", "assessment_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["misconception", "prerequisite"]},
        "description": {"type": "string", "minLength": 1},
        "assessment_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "gap_resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["gap_id", "assessment_id", "rationale"],
      "properties": {
        "gap_id": {"$ref": "#/$defs/id"},
        "assessment_id": {"$ref": "#/$defs/id"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["objective_ids", "claim", "reasoning", "source_reference"],
      "properties": {
        "objective_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "claim": {"type": "string", "minLength": 1},
        "reasoning": {"type": "string", "minLength": 1},
        "source_reference": {"type": "string", "minLength": 1}
      }
    },
    "objective": {
      "type": "object", "additionalProperties": false,
      "required": ["objective_id", "coverage", "judgment", "assessments"],
      "properties": {
        "objective_id": {"$ref": "#/$defs/id"},
        "coverage": {"enum": ["covered", "unassessed"]},
        "judgment": {"enum": ["demonstrated", "needs-practice", "uncertain"]},
        "assessments": {"type": "array", "items": {"$ref": "#/$defs/assessment"}},
        "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
        "resolved_gaps": {"type": "array", "items": {"$ref": "#/$defs/gap_resolution"}}
      },
      "allOf": [{
        "if": {"properties": {"assessments": {"contains": {"required": ["phase"]}}}},
        "then": {"properties": {"assessments": {"items": {"required": ["phase", "before_teaching", "resolves"]}}}}
      }]
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["assessment_id", "question", "learner_answer", "rubric", "rationale", "result", "assistance", "assistance_details", "kind", "fresh", "independent", "valid"],
      "properties": {
        "assessment_id": {"$ref": "#/$defs/id"},
        "question": {"type": "string", "minLength": 1},
        "learner_answer": {"type": "string"},
        "rubric": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail", "ungradable"]},
        "assistance": {"enum": ["none", "light", "heavy", "answer-revealed"]},
        "assistance_details": {"type": "string"},
        "kind": {"enum": ["recall", "explain-back", "application"]},
        "fresh": {"type": "boolean"},
        "independent": {"type": "boolean"},
        "valid": {"type": "boolean"},
        "phase": {"enum": ["diagnostic", "practice", "assessment"]},
        "before_teaching": {"type": "boolean"},
        "resolves": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      },
      "dependentRequired": {
        "phase": ["before_teaching", "resolves"],
        "before_teaching": ["phase", "resolves"],
        "resolves": ["phase", "before_teaching"]
      }
    }
  }
}
